# Linq API key — get this from your Linq representative
LINQ_API_KEY=

# The phone number assigned to your Linq account (E.164 format)
LINQ_PHONE_NUMBER=+12223334444

# Webhook signing secret — copy this from the output of register-webhook.ts
# Leave blank during initial setup, add it after step 4
WEBHOOK_SECRET=

# Your ngrok public URL — update this each time you restart ngrok
PUBLIC_URL=

# Server port
PORT=3000

# Anthropic API key — get one at console.anthropic.com (free credits on signup)
# Optional: app falls back to static workouts and rule-based parsing without this
ANTHROPIC_API_KEY=

# OpenWeatherMap API key — get one at openweathermap.org (free tier)
# Optional: weather context is skipped if not set
OPENWEATHER_API_KEY=
